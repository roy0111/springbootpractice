<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ── Parent ─────────────────────────────────────────── -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <!-- ── Project coordinates ───────────────────────────── -->
    <groupId>com.learn</groupId>
    <artifactId>restapi</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>restapi</name>
    <description>Spring Boot Reactive REST API + Actuator + Swagger learning project</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- ── Dependencies ──────────────────────────────────── -->
    <dependencies>

        <!--
            ┌─────────────────────────────────────────────┐
            │  REACTIVE WEB STACK (Spring WebFlux / Netty) │
            └─────────────────────────────────────────────┘
            Replaces spring-boot-starter-web (Servlet/Tomcat).
            Controllers return Mono<T> / Flux<T> instead of T.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
            ┌─────────────────────────────────────────────┐
            │  REACTIVE DATA ACCESS (Spring Data R2DBC)    │
            └─────────────────────────────────────────────┘
            Replaces spring-boot-starter-data-jpa.
            Repositories return Flux<T> / Mono<T> — no thread blocking.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-r2dbc</artifactId>
        </dependency>

        <!-- R2DBC driver for H2 (reactive, non-blocking) -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-h2</artifactId>
            <!-- version managed by Spring Boot BOM -->
        </dependency>

        <!-- H2 JDBC jar — still needed for spring.sql.init schema scripts -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Actuator (health, metrics, info …) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean Validation (@Valid, @NotBlank, @Min …) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            ┌─────────────────────────────────────────────┐
            │  SWAGGER / OpenAPI (WebFlux edition)         │
            └─────────────────────────────────────────────┘
            Provides:
              • Swagger UI  → http://localhost:8080/swagger-ui.html
              • OpenAPI JSON → http://localhost:8080/v3/api-docs
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!--
            ┌─────────────────────────────────────────────┐
            │  CIRCUIT BREAKER — Resilience4j              │
            └─────────────────────────────────────────────┘
            Three artifacts are needed:
              1. resilience4j-spring-boot3  → auto-config, @CircuitBreaker annotation,
                                              Actuator health indicator + metrics
              2. resilience4j-reactor       → CircuitBreakerOperator.of() for reactive
                                              pipelines (transformDeferred)
              3. spring-boot-starter-aop   → required for annotation-based CB to work
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
            ┌─────────────────────────────────────────────┐
            │  SPRING AI — Anthropic Claude LLM           │
            └─────────────────────────────────────────────┘
            Spring AI integration for Claude Models (e.g. claude-3-5-sonnet).
            ChatClient / AnthropicChatModel non-blocking / blocking API integration.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic-spring-boot-starter</artifactId>
        </dependency>

        <!--
            ┌─────────────────────────────────────────────┐
            │  SPRING KAFKA — Messaging / Event Streaming │
            └─────────────────────────────────────────────┘
            Spring Kafka integration for Producer, Consumer, Topic Admin, and Reactive Kafka.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            ┌─────────────────────────────────────────────┐
            │  SPRING SECURITY (OAuth2 Resource Server)   │
            └─────────────────────────────────────────────┘
            Validates JWT tokens for securing REST APIs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Tests (includes Reactor test utilities like StepVerifier) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ── Dependency Management for Spring AI ──────────── -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0-M1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ── Repositories for Spring AI Milestones ────────── -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- ── Build ─────────────────────────────────────────── -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
